{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "freetouch/horse.schema.json",
  "title": "Free Touch HORSE shot list",
  "description": "Each rep calls a shot. Missing the required chain (or not scoring when requireGoal) earns a letter.",
  "type": "object",
  "required": ["id", "name", "word", "shots"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
    "name": { "type": "string" },
    "word": { "type": "string", "default": "HORSE" },
    "order": { "enum": ["shuffle", "sequential", "escalating"], "default": "escalating" },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "chain", "setup"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "chain": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "setup": { "type": "string" },
          "requireGoal": { "type": "boolean", "default": true },
          "tier": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    }
  }
}
